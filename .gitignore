# Public entry points: new root items need an explicit review and exception.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CONTRIBUTING.md
!/AGENTS.md
!/src/
!/tests/
!/docs/
/docs/*
!/docs/public/

# Private instructions, personal skills and internal material stay local.
.agents/
.codex/
.project-harness/
AGENTS.override.md
START_HIER.md
MANIFEST.sha256
private/
internal/
playbooks/
customer-data/
kundendaten/
imports/
exports/
uploads/
attachments/
backups/
secrets/
credentials/
.aws/
.azure/
.ssh/

# Original spreadsheets, business documents, archives and database copies.
# Synthetic fixtures in these formats require a separate reviewed exception.
*.[xX][lL][sS]
*.[xX][lL][sS][xX]
*.[xX][lL][sS][mM]
*.[xX][lL][sS][bB]
*.[cC][sS][vV]
*.[tT][sS][vV]
*.[pP][dD][fF]
*.[dD][oO][cC]
*.[dD][oO][cC][xX]
*.[oO][dD][tT]
*.[pP][pP][tT][xX]
*.zip
*.7z
*.tar
*.gz
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.mdf
*.ldf
*.dump
*.sql
*.bak

# Secrets and machine-specific settings.
.env
.env.*
*.env
*.env.*
*.pem
*.key
*.pfx
*.p12
*.p8
*.keystore
*.jks
.npmrc
.netrc
NuGet.Config
nuget.config
appsettings*.json
*.pubxml
*.pubxml.user
launchSettings.json
*credentials*.json
*secret*.json

# Generated files and local tools.
.vs/
.idea/
.vscode/
**/bin/
**/obj/
node_modules/
dist/
coverage/
TestResults/
__pycache__/
*.py[cod]
.venv/
venv/
*.user
*.suo
*.log
*.tmp
.DS_Store
Thumbs.db
